- 初回だけ: <<初期化関数のファイルと関数名>> の後ろに `ensureIndex` を足す
- index ごとに、初期化関数の末尾（DELETE などの後）へ `ensureIndex(...)` を 1 行足す
```go
	ensureIndex(ctx, "<table>", "idx_<cols>", "<col1>, <col2>")
}

// MySQL 8.0 は CREATE INDEX IF NOT EXISTS が無いので、information_schema で有無を見てから貼る
func ensureIndex(ctx context.Context, table, name, cols string) {
	var n int
	if err := db.GetContext(ctx, &n, "SELECT COUNT(*) FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = ? AND index_name = ?", table, name); err != nil {
		log.Print(err)
		return
	}
	if n > 0 {
		return
	}
	if _, err := db.ExecContext(ctx, fmt.Sprintf("ALTER TABLE %s ADD INDEX %s (%s)", table, name, cols)); err != nil {
		log.Print(err)
	}
}
```
- 失敗はログに出す（エラーを捨てる既存の SQL ループに `ALTER` を混ぜると、書き間違いに気づけないため）
